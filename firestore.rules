rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all para zero-trust
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Coleção de Usuários
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Ninguém pode listar todos os usuários da plataforma
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Subcoleção de Contas do Usuário
      match /accounts/{accountId} {
        allow read, write: if isOwner(userId) && isValidId(accountId);
      }

      // Subcoleção de Transações do Usuário
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) && isValidId(transactionId);
      }

      // Subcoleção de Orçamentos do Usuário
      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId) && isValidId(budgetId);
      }

      // Subcoleção de Consentimentos Open Finance do Usuário
      match /consents/{consentId} {
        allow read, write: if isOwner(userId) && isValidId(consentId);
      }
    }
  }
}
